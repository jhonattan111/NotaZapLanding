---
// Ícones SVG inline (line, stroke 1.8) — equivalentes Lucide: phone, clock,
// map-pin, shield-check. `bubble` é o balão genérico dos CTAs (NÃO a marca do
// WhatsApp); `whatsapp` é o glifo oficial da marca, usado só no botão
// flutuante onde o reconhecimento do ícone importa mais que a neutralidade.
// Reproduz as funções ic()/wa() do protótipo.
interface Props {
  name: 'phone' | 'clock' | 'pin' | 'shield' | 'bubble' | 'whatsapp';
  size?: number;
}

const { name, size = 20 } = Astro.props;

const paths: Record<Exclude<Props['name'], 'bubble' | 'whatsapp'>, string> = {
  phone: 'M7 2h10v20H7zM10 18h4',
  clock: 'M12 7v5l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  pin: 'M12 22s7-7 7-12a7 7 0 10-14 0c0 5 7 12 7 12zM12 10a1 1 0 100-2 1 1 0 000 2z',
  shield: 'M12 2l8 3v6c0 5-3.5 8-8 11-4.5-3-8-6-8-11V5l8-3zM9 12l2 2 4-4',
};
---

{
  name === 'bubble' ? (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 2C6.5 2 2 6.1 2 11.2c0 1.8.6 3.5 1.6 5L2 22l6-1.6c1.2.5 2.6.8 4 .8 5.5 0 10-4.1 10-9.2S17.5 2 12 2z" />
    </svg>
  ) : name === 'whatsapp' ? (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .16 5.304.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.68 1.447h.005c6.585 0 11.89-5.304 11.893-11.893a11.821 11.821 0 00-3.421-8.451" />
    </svg>
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={paths[name]} />
    </svg>
  )
}
