---
import settings from '../data/settings.json';

// ID vem das Configurações do site (/admin). Vazio = Clarity desligado,
// nada é renderizado — seguro deployar antes de criar o projeto.
const clarityId = settings.clarityProjectId;
---

{
  clarityId && (
    <script is:inline define:vars={{ clarityId }}>
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
        t = l.createElement(r); t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);

      // Atenção (LGPD): o nível de mascaramento das gravações é ajuste do
      // painel do Clarity (Settings > Masking), não deste arquivo. Manter em
      // "Mask all" ou "Balanced" — e declarar o uso na política de privacidade.

      // Mesma convenção do GA4/Pixel: marca a sessão em que houve clique de
      // WhatsApp, para filtrar gravações de quem converteu (e de quem não).
      document.addEventListener('click', function (e) {
        var a = e.target instanceof Element
          ? e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]')
          : null;
        if (!a) return;
        window.clarity('set', 'cta_origem', a.dataset.cta || 'nao-identificado');
        window.clarity('event', 'contato_whatsapp');
      });
    </script>
  )
}
