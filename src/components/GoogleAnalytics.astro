---
import settings from '../data/settings.json';

// ID vem das Configurações do site (/admin). Vazio = GA4 desligado,
// nada é renderizado — seguro deployar antes de criar a propriedade.
const ga4Id = settings.ga4MeasurementId;
---

{
  ga4Id && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}
      />
      <script is:inline define:vars={{ ga4Id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', ga4Id);

        // Mesmo critério do Pixel: clique em link de WhatsApp é a conversão
        // do site. Marcar "contato_whatsapp" como evento-chave no GA4.
        document.addEventListener('click', function (e) {
          var a = e.target instanceof Element
            ? e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]')
            : null;
          if (a) gtag('event', 'contato_whatsapp');
        });
      </script>
    </>
  )
}
