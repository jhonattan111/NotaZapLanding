---
// Botão flutuante fixo, presente em todas as páginas via Layout.astro.
import Icon from './Icon.astro';
import { WHATSAPP_FLOAT_LINK } from '../config';
---

<a
  class="oa-wa-float"
  href={WHATSAPP_FLOAT_LINK}
  data-cta="flutuante"
  target="_blank"
  rel="noopener"
  aria-label="Falar com a NotaZap no WhatsApp"
>
  <Icon name="whatsapp" size={28} />
</a>
